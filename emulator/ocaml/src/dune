; tara.ml is generated by Sail (just ocaml generate); its warnings are not ours.

(library
 (name tara)
 (modules tara)
 (libraries libsail)
 (flags
  (:standard -w -a)))

(executable
 (name main)
 (modules :standard \ tara)
 (libraries
  core
  core_unix
  core_unix.command_unix
  core_unix.filename_unix
  core_unix.signal_unix
  libsail
  tara)
 (preprocess
  (pps ppx_jane))
 ; Every warning is on and an error, except these three, which Core and ppx_jane code needs:
 ; 40 name-out-of-scope: ppx_jane's output and Core's records pick variants and fields by type.
 ; 42 disambiguated-name: the same pick by type, reported again at each use.
 ; 44 open-shadow-identifier: Time_ns.O.(now < until) is how Core compares times.
 (flags
  (:standard -w +a-40-42-44 -warn-error +a)))
