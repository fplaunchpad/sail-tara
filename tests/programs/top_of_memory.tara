; PC wraps at the top of memory: a CALL at 0x7FE links 0x000, the 11-bit PC + 2, and its target
; wraps to the bottom. The callee returns to 0x000, where the program finds itself on its second
; pass and halts.

start:  BZ   R5, setup      ; first pass: R5 = 0
        HLT                 ; second pass
callee: MOV  R4, R6         ; R4 = the link, 0x0000
        RET                 ; to 0x000
setup:  ADDI R5, 1
        LIL  R1, 0x02
        LIH  R1, 0xB8       ; R1 = 0xB802, CALL 2: 0x7FE + 2 + 2 * 2 wraps to 0x004, callee
        LIL  R2, 0xFE
        LIH  R2, 0x07       ; R2 = 0x07FE
        STW  R1, 0(R2)      ; CALL 2 at 0x7FE
        MOV  R6, R2
        RET                 ; to 0x7FE
